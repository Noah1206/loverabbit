{
  "name": "loverabbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:login": "npx -y supabase@latest login",
    "db:link": "npx -y supabase@latest link --project-ref uaaxqqzdfmuzzwgqsdki",
    "db:status": "npx -y supabase@latest migration list",
    "db:new": "npx -y supabase@latest migration new",
    "db:push": "npx -y supabase@latest db push",
    "test": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "myeongri:audit:branch-yinyang": "tsx scripts/audit-branch-yinyang.mts",
    "threads:benchmark:validate": "tsx scripts/threads-benchmark.mts validate",
    "threads:benchmark:analyze": "tsx scripts/threads-benchmark.mts analyze",
    "threads:drafts:generate": "tsx --env-file=.env.local --env-file=.env scripts/threads-drafts.mts generate",
    "threads:drafts:review": "tsx scripts/threads-drafts.mts review",
    "threads:drafts:preview": "tsx scripts/threads-drafts.mts preview",
    "threads:drafts:reuse": "tsx --env-file=.env.local --env-file=.env scripts/threads-drafts.mts generate --batch reuse",
    "threads:permission:status": "tsx scripts/threads-drafts.mts permission",
    "reading:audit": "tsx scripts/reading-audit.mts",
    "myeongri:audit:advanced": "tsx scripts/advanced-audit.mts",
    "reading:preview": "tsx --env-file=.env.local --env-file=.env scripts/reading-preview.mts",
    "demo:fixture": "tsx --env-file=.env.local --env-file=.env scripts/demo-fixture.mts",
    "reading:cost": "tsx scripts/reading-cost.mts",
    "reading:sweep": "tsx scripts/reading-sweep.mts",
    "ai:doctor": "tsx --env-file=.env.local --env-file=.env scripts/ai-doctor.mts",
    "reviews:import": "tsx --env-file=.env.local --env-file=.env scripts/import-beta-reviews.mts",
    "telegram:test": "tsx --env-file=.env.local --env-file=.env scripts/telegram-test.mts",
    "prebuild": "node marketing/video/build-character-motion.mjs",
    "motion:build": "node marketing/video/build-character-motion.mjs",
    "free-preview:once": "tsx --env-file=.env.local --env-file=.env scripts/free-preview-once.mts",
    "model:routing": "tsx --env-file=.env.local --env-file=.env scripts/model-routing.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tosspayments/tosspayments-sdk": "2.7.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "korean-lunar-calendar": "^0.4.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "@loverabbit/myeongri": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "puppeteer-core": "^25.8.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
