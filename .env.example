# AI 제공사 — 아래 중 하나만 채우면 됩니다. 모두 없으면 데모 모드(목업 리딩).
# 우선순위: Anthropic → Gemini → OpenAI 호환
ANTHROPIC_API_KEY=
# Google Gemini: https://aistudio.google.com 에서 무료 발급
GEMINI_API_KEY=
# OpenAI 또는 호환 API (OpenRouter/Groq/Ollama — OPENAI_BASE_URL로 전환)
OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_MODEL=

# 토스페이먼츠 결제위젯 클라이언트 키 (https://developers.tosspayments.com)
# 테스트 키: test_ck_... 로 시작
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# PASS 본인인증 (포트원/아임포트 등) — 상용 런칭 전 필수
# 청소년보호법상 청소년유해매체물 제공 시 성인인증 의무
PORTONE_IMP_KEY=
