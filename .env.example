# AI 제공사 — 아래 중 하나만 채우면 됩니다. 모두 없으면 데모 모드(목업 리딩).
# 우선순위: Anthropic → Gemini → OpenAI 호환
ANTHROPIC_API_KEY=
# Google Gemini: https://aistudio.google.com 에서 무료 발급
GEMINI_API_KEY=
# OpenAI 또는 호환 API (OpenRouter/Groq/Ollama — OPENAI_BASE_URL로 전환)
OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_MODEL=

# 서비스 정식 주소 — OAuth 콜백과 canonical URL에 사용합니다.
NEXT_PUBLIC_SITE_URL=https://loverebbit.xyz

# Supabase — 서버 전용. SUPABASE_SECRET_KEY는 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# OAuth/SSR 세션용 공개 키. 공개 가능한 값이지만 서버 라우트에서만 사용합니다.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 이전 프로젝트의 service_role 키를 쓸 때만 대체 변수로 사용
#SUPABASE_SERVICE_ROLE_KEY=

# 가입/리딩 토큰 암호화용. 운영에서는 충분히 긴 임의 문자열 필수.
READING_SECRET=

# 토스페이먼츠 결제위젯 클라이언트 키 (https://developers.tosspayments.com)
# 테스트 키: test_ck_... 로 시작
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 계좌이체 안내
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=

# 수동 입금 승인 관리자 페이지(/admin/payments) 접근 키. 최소 16자.
ADMIN_APPROVAL_KEY=

# PASS 본인인증 (포트원/아임포트 등) — 상용 런칭 전 필수
# 청소년보호법상 청소년유해매체물 제공 시 성인인증 의무
PORTONE_IMP_KEY=

# 로컬 비상용 파일 저장소 허용. 운영에서는 사용하지 마세요.
#ALLOW_FILE_STORE=true

# ── Meta 광고 전환 추적 ──────────────────────────────────────────────
# Events Manager에서 Pixel(Dataset)을 만든 뒤 ID를 넣는다. 비워두면 추적이 통째로 꺼진다.
NEXT_PUBLIC_META_PIXEL_ID=
# 서버 전환 API(CAPI)용. 클라이언트 번들에 들어가면 안 되므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# 개발 중 Events Manager '테스트 이벤트' 탭 검증용. 운영에서는 반드시 비운다.
META_CAPI_TEST_EVENT_CODE=

# ── 법정 기재사항 (전자상거래법 제10조 / 개인정보보호법 제30조) ──────
# /privacy 의 '사업자 정보'와 '개인정보 보호책임자'에 그대로 찍힌다.
# 비워두면 화면에 '미기재'로 남는다. 유료 결제를 받는다면 전부 필수.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
# 하이픈 포함 10자리. 예: 123-45-67890
NEXT_PUBLIC_BUSINESS_REGISTRATION_NO=
# 예: 2026-서울강남-01234
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_NO=
# 신고를 받은 지자체. 예: 서울특별시 강남구청
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_AUTHORITY=
# 영업소 소재지 — 소비자 불만을 접수할 수 있는 주소
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
# 사이버몰 호스팅 제공자. 비우면 Vercel Inc. 로 표시된다.
#NEXT_PUBLIC_HOSTING_PROVIDER=

# 개인정보 보호책임자. 메일·전화를 비우면 위 대표 연락처를 그대로 쓴다.
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=
#NEXT_PUBLIC_PRIVACY_OFFICER_TITLE=대표
#NEXT_PUBLIC_PRIVACY_OFFICER_EMAIL=
#NEXT_PUBLIC_PRIVACY_OFFICER_PHONE=

# ── 리딩 생성 성능 ──────────────────────────────────────────────
# gpt-5 계열은 max_completion_tokens / reasoning_effort 를 쓴다 (ai.ts가 알아서 맞춘다).
# 실측: 목차 10개 리포트 1회 요청 = gpt-4o 37초 / gpt-5.6 128초.
# 그래서 리포트를 묶음으로 잘라 동시에 생성한다. 전체 시간은 가장 큰 묶음이 정한다.
#OPENAI_MODEL=gpt-5.6
#OPENAI_REASONING_EFFORT=low     # minimal | low | medium | high
#READING_BATCH_SIZE=3            # 한 요청이 맡는 목차 항목 수 (1~8). 작을수록 빠르고 비싸다.

# ── Gemini로 생성할 때 ──────────────────────────────────────────
# GEMINI_API_KEY만 채우면 OpenAI보다 먼저 잡힌다 (우선순위: Anthropic > Gemini > OpenAI).
#GEMINI_MODEL=gemini-2.5-flash
# 성적 표현 차단 문턱. 속궁합·연애 기질은 이 기준이 조이면 응답이 통째로 비어 온다.
# 막히면 로그에 blockReason / blocked 카테고리가 찍히니 그때 한 단계 푼다.
# BLOCK_NONE | BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE(기본) | BLOCK_LOW_AND_ABOVE
#GEMINI_SAFETY_SEXUAL=BLOCK_ONLY_HIGH
